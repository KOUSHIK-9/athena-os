# Athena OS Configuration
# Copy to .env and fill in values

# Device Configuration
ATHENA_DEVICE_UDID=
ATHENA_AUTO_DETECT=true
ATHENA_DEVELOPER_MODE_CHECK=true

# Appium Configuration
ATHENA_APPIUM_HOST=127.0.0.1
ATHENA_APPIUM_PORT=4723
ATHENA_APPIUM_TIMEOUT=30000
ATHENA_APPIUM_RETRIES=3
ATHENA_WDA_PATH=

# Server Configuration
ATHENA_SERVER_HOST=127.0.0.1
ATHENA_SERVER_PORT=3000

# MCP Configuration
ATHENA_MCP_TRANSPORT=stdio
ATHENA_MCP_HTTP_PORT=3001
ATHENA_MCP_WS_PORT=3002

# Logging
LOG_LEVEL=info
NODE_ENV=development