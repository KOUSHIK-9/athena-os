{
  "name": "@athena-os/mcp-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./bin": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.build.json",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src --ignore-path ../../.prettierignore",
    "format:check": "prettier --check src --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@athena-os/iphone-agent": "workspace:*",
    "@athena-os/memory": "workspace:*",
    "@athena-os/reasoning": "workspace:*",
    "@athena-os/reasoning-backends": "workspace:*",
    "@athena-os/sdk": "workspace:*",
    "@athena-os/shared": "workspace:*",
    "@athena-os/executor": "workspace:*",
    "@athena-os/understanding": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "catalog:",
    "@athena-os/core": "workspace:*",
    "pino": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:"
  }
}
