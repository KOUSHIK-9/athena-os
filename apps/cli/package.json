{
  "name": "@athena-os/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "athena": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.build.json",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src --ignore-path ../../.prettierignore",
    "format:check": "prettier --check src --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@athena-os/iphone-agent": "workspace:*",
    "@athena-os/sdk": "workspace:*",
    "@athena-os/shared": "workspace:*",
    "@athena-os/executor": "workspace:*",
    "@athena-os/mcp-server": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:"
  }
}
